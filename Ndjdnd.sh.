import React, { useEffect, useState } from "react";
import { createRoot } from "react-dom/client";
import { io } from "socket.io-client";
import "./style.css";

const API = import.meta.env.VITE_API_URL || "";
const tg = window.Telegram?.WebApp;
const initData = tg?.initData || "";
tg?.ready?.();
tg?.expand?.();

function App() {
  const [name, setName] = useState(tg?.initDataUnsafe?.user?.first_name || "Гость");
  const [roomId, setRoomId] = useState(new URLSearchParams(location.search).get("room") || "");
  const [room, setRoom] = useState(null);
  const [socket, setSocket] = useState(null);
  const [message, setMessage] = useState("");
  const [video, setVideo] = useState("");
  const [error, setError] = useState("");

  useEffect(() => {
    const s = io(API || undefined, { auth: { initData } });
    setSocket(s);
    s.on("room:update", setRoom);
    s.on("room:error", setError);
    s.on("connect_error", e => setError(e.message));
    return () => s.disconnect();
  }, []);

  async function createRoom() {
    try {
      const r = await fetch(`${API}/api/rooms`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-telegram-init-data": initData
        },
        body: JSON.stringify({ name })
      });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || "Ошибка");
      setRoomId(data.room.id);
      history.replaceState({}, "", `?room=${data.room.id}`);
      socket?.emit("room:join", { roomId: data.room.id });
    } catch (e) {
      setError(e.message);
    }
  }

  function joinRoom() {
    socket?.emit("room:join", { roomId: roomId.trim().toUpperCase() });
  }

  function sendMessage(e) {
    e.preventDefault();
    if (!message.trim()) return;
    socket.emit("chat:message", { roomId, text: message.trim() });
    setMessage("");
  }

  function setVideoUrl(e) {
    e.preventDefault();
    if (!video.trim()) return;
    socket.emit("video:set", { roomId, url: video.trim() });
    setVideo("");
  }

  function invite() {
    navigator.clipboard?.writeText(
      `${location.origin}${location.pathname}?room=${roomId}`
    );
  }

  const videoId = room?.videoUrl
    ? (() => {
        try {
          const u = new URL(room.videoUrl);
          return u.hostname.includes("youtu.be")
            ? u.pathname.slice(1)
            : u.searchParams.get("v");
        } catch {
          return "";
        }
      })()
    : "";

  return (
    <main>
      <header>
        <div className="logo">🍿</div>
        <div>
          <h1>Together Cinema</h1>
          <p>Ваш маленький кинозал на двоих ❤️</p>
        </div>
      </header>

      {!room ? (
        <section className="panel">
          <h2>Смотрим вместе?</h2>
          <p>Создай комнату или введи код приглашения.</p>
          <label>Твоё имя</label>
          <input value={name} onChange={e => setName(e.target.value)} />
          <button onClick={createRoom}>Создать комнату ❤️</button>
          <div className="or">или присоединиться</div>
          <label>Код комнаты</label>
          <input
            value={roomId}
            onChange={e => setRoomId(e.target.value.toUpperCase())}
            placeholder="Например, A1B2C3"
          />
          <button className="secondary" onClick={joinRoom}>
            Войти в комнату
          </button>
        </section>
      ) : (
        <section className="panel">
          <h2>Комната {room.id}</h2>
          <button className="secondary" onClick={invite}>
            Скопировать приглашение
          </button>
          <p>Участники: {(room.members || []).map(x => x.name).join(", ")}</p>
          <form onSubmit={setVideoUrl}>
            <label>Ссылка на YouTube</label>
            <input
              value={video}
              onChange={e => setVideo(e.target.value)}
              placeholder="https://youtube.com/watch?v=..."
            />
            <button>Установить видео</button>
          </form>
          {videoId && (
            <div className="video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                title="Видео"
                allowFullScreen
              />
            </div>
          )}
          <h3>Общий чат 💬</h3>
          <div className="messages">
            {(room.messages || []).map((m, i) => (
              <p key={i}><b>{m.name}:</b> {m.text}</p>
            ))}
          </div>
          <form onSubmit={sendMessage} className="chat">
            <input
              value={message}
              onChange={e => setMessage(e.target.value)}
              placeholder="Напиши что-нибудь нежное…"
            />
            <button>➤</button>
          </form>
        </section>
      )}
      {error && <p className="error">{error}</p>}
      <footer>Сделано для уютных вечеров ✨</footer>
    </main>
  );
}

createRoot(document.getElementById("root")).render(<App />);
EOF

