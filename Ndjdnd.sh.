cat > server/index.js <<'EOF'
import express from "express";
import http from "http";
import cors from "cors";
import dotenv from "dotenv";
import crypto from "crypto";
import { Server } from "socket.io";

dotenv.config();
const app = express();
const server = http.createServer(app);
const allowed = (process.env.CLIENT_ORIGIN || "http://localhost:5173")
  .split(",").map(x => x.trim());

app.use(cors({ origin: allowed }));
app.use(express.json());

function telegramUser(initData) {
  if (!process.env.BOT_TOKEN) return { id: "demo", first_name: "Гость" };
  if (!initData) return null;
  const params = new URLSearchParams(initData);
  const hash = params.get("hash");
  params.delete("hash");
  const check = [...params.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([k, v]) => `${k}=${v}`).join("\n");
  const secret = crypto.createHmac("sha256", "WebAppData")
    .update(process.env.BOT_TOKEN).digest();
  const expected = crypto.createHmac("sha256", secret)
    .update(check).digest("hex");
  if (!hash || hash.length !== expected.length ||
      !crypto.timingSafeEqual(Buffer.from(hash), Buffer.from(expected))) return null;
  try { return JSON.parse(params.get("user") || "{}"); }
  catch { return null; }
}

const rooms = new Map();

app.get("/api/health", (_, res) => res.json({ ok: true }));

app.post("/api/rooms", (req, res) => {
  const user = telegramUser(req.get("x-telegram-init-data"));
  if (!user) return res.status(401).json({ error: "Открой приложение через Telegram" });
  const id = crypto.randomBytes(3).toString("hex").toUpperCase();
  const room = {
    id,
    members: [{ id: String(user.id), name: req.body.name || user.first_name || "Гость" }],
    messages: [],
    videoUrl: ""
  };
  rooms.set(id, room);
  res.json({ room });
});

const io = new Server(server, { cors: { origin: allowed } });
io.use((socket, next) => {
  const user = telegramUser(socket.handshake.auth?.initData);
  if (!user) return next(new Error("Открой приложение через Telegram"));
  socket.user = user;
  next();
});

io.on("connection", socket => {
  socket.on("room:join", ({ roomId }) => {
    const room = rooms.get(String(roomId || "").toUpperCase());
    if (!room) return socket.emit("room:error", "Комната не найдена");
    socket.join(room.id);
    const member = {
      id: String(socket.user.id),
      name: socket.user.first_name || "Гость"
    };
    if (!room.members.some(x => x.id === member.id)) room.members.push(member);
    socket.data.roomId = room.id;
    io.to(room.id).emit("room:update", room);
  });

  socket.on("chat:message", ({ roomId, text }) => {
    const room = rooms.get(String(roomId || "").toUpperCase());
    if (!room || socket.data.roomId !== room.id || typeof text !== "string") return;
    room.messages.push({
      name: socket.user.first_name || "Гость",
      text: text.slice(0, 500)
    });
    room.messages = room.messages.slice(-100);
    io.to(room.id).emit("room:update", room);
  });

  socket.on("video:set", ({ roomId, url }) => {
    const room = rooms.get(String(roomId || "").toUpperCase());
    if (!room || socket.data.roomId !== room.id || typeof url !== "string") return;
    if (!/^https:\/\/(www\.)?(youtube\.com|youtu\.be)\//.test(url)) return;
    room.videoUrl = url;
    io.to(room.id).emit("room:update", room);
  });
});

const port = process.env.PORT || 3001;
server.listen(port, "0.0.0.0", () => {
  console.log(`Together Cinema listening on ${port}`);
});
EOF

